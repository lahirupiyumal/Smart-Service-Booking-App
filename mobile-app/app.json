{
  "expo": {
    "name": "Smart Service Booking",
    "slug": "smart-service-booking",
    "version": "0.1.0",
    "scheme": "smartservicebooking",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.smartservice.booking",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
